{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vector Free",
  "version": "0.2.0",
  "identifier": "org.vectorfree.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vector Free",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
