{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vector Free",
  "version": "0.4.0",
  "identifier": "org.vectorfree.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vector Free",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "zavants",
    "homepage": "https://github.com/zavants/VectorFree",
    "copyright": "Copyright (c) 2026 zavants and Vector Free contributors",
    "shortDescription": "Bitmap to vector tracer",
    "longDescription": "Open-source bitmap-to-vector tracer: turn PNG/JPG images into SVG, PDF, EPS, AI and DXF.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MjI1RjE4RDMxNDk2ODAKUldTQWxoVFRHRjhpbElYbjZRaVhHKzBWYlBTcWw4RkVMOWZQT1lqTVJtSVpnb0RjOCt2QjBGR1AK",
      "endpoints": ["https://github.com/zavants/VectorFree/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
